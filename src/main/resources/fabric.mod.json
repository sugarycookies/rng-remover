{
	"schemaVersion": 1,
	"id": "rng-remover",
	"version": "0.0.8",
	"name": "RNG Remover",
	"description": "Remove the RNG from your Minecraft world in multiple ways, and make it return a different number.",
	"authors": [
		"VI-Benexor",
		"Jason13"
	],
	"contact": {
		"email": "vibenexor@gmail.com",
		"discord": "@jason13",
		"sources": "https://github.com/sugarycookies/rng-remover"
	},
	"license": "CC0-1.0",
	"icon": "assets/rng-remover/RNG Remover cover.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"vibenexor.rngremover.RNGRemover"
		],
		"client": [
			"vibenexor.rngremover.client.RNGRemoverClient"
		]
	},
	"mixins": [
		"rng-remover.mixins.json",
		{
			"config": "rng-remover.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
